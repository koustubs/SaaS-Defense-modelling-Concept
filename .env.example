# Generate a development value with:
# python scripts/generate_development_key.py
NOTES_MASTER_KEY=

# Illustrative values; the application reads process environment variables directly.
# This relative SQLite path resolves from the repository root when run as documented.
NOTES_DATABASE_URL=sqlite+pysqlite:///notes-demo.db
NOTES_ENV=development
NOTES_SESSION_IDLE_SECONDS=900
NOTES_SESSION_ABSOLUTE_SECONDS=28800
NOTES_LOGIN_MAX_FAILURES=5
NOTES_LOCKOUT_SECONDS=900
NOTES_MAX_REQUEST_BYTES=20000
NOTES_MAX_NOTES_PER_USER=100
